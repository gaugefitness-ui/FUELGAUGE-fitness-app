PORT=3000
MONGO_URI=mongodb://localhost:27017/fuelgauge

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8100,capacitor://localhost,ionic://localhost

# App URL (for payment callbacks)
APP_URL=http://localhost:3000

# Email (Nodemailer)
EMAIL_USER=
EMAIL_PASS=

# Twilio SMS OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# eSewa Payment Gateway
# Register at https://developer.esewa.com.np (sandbox) or https://esewa.com.np (production)
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
ESEWA_ENV=sandbox
ESEWA_SUCCESS_URL=http://localhost:3000/api/payment/esewa/callback
ESEWA_FAILURE_URL=http://localhost:3000/api/payment/esewa/callback

# Khalti Payment Gateway
# Register at https://khalti.com/merchant
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
KHALTI_ENV=sandbox

# Bank Transfer (for manual verification)
BANK_NAME=Nabil Bank
BANK_ACCOUNT_NAME=FUELGAUGE Fitness Pvt. Ltd.
BANK_ACCOUNT_NUMBER=01234567890123

# JWT Secret (CHANGE THIS in production!)
JWT_SECRET=change-this-to-a-random-secret-in-production
