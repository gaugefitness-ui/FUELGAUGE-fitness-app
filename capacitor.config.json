{
  "appId": "com.fuelgauge.app",
  "appName": "FUELGAUGE",
  "webDir": "public",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "GoogleAuth": {
      "scopes": ["profile", "email"],
      "serverClientId": "449230108797-tks2lkji381a7qbf2qk66vmn72nk4st4.apps.googleusercontent.com",
      "forceCodeForRefreshToken": true
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0d0f14",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "launchAutoHide": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0d0f14",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "resizeOnFullScreen": true
    },
    "Browser": {
      "androidTintColor": "#ff3c1f"
    }
  },
  "android": {
    "backgroundColor": "#0d0f14",
    "allowMixedContent": true,
    "buildOptions": {
      "keystorePath": null,
      "keystoreAlias": null
    }
  },
  "ios": {
    "backgroundColor": "#0d0f14",
    "contentInset": "automatic",
    "allowsBackForwardNavigationGestures": true
  }
}
